{
  "_meta": {
    "name": "InstantImpact Qwen Image Edit garment try-on",
    "source": "Comfy-Org image_qwen_image_edit template",
    "version": 1
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{QWEN_UNET_NAME}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "{{QWEN_LORA_NAME}}",
      "strength_model": 1.0
    }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": ["2", 0],
      "shift": 3.0
    }
  },
  "4": {
    "class_type": "CFGNorm",
    "inputs": {
      "model": ["3", 0],
      "strength": 1.0
    }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{QWEN_CLIP_NAME}}",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{QWEN_VAE_NAME}}"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{TRYON_INPUT_IMAGE}}"
    }
  },
  "8": {
    "class_type": "TextEncodeQwenImageEdit",
    "inputs": {
      "clip": ["5", 0],
      "vae": ["6", 0],
      "image": ["7", 0],
      "prompt": "{{TRYON_PROMPT}}"
    }
  },
  "9": {
    "class_type": "TextEncodeQwenImageEdit",
    "inputs": {
      "clip": ["5", 0],
      "vae": ["6", 0],
      "image": ["7", 0],
      "prompt": "{{TRYON_NEGATIVE}}"
    }
  },
  "10": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["7", 0],
      "vae": ["6", 0]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["8", 0],
      "negative": ["9", 0],
      "latent_image": ["10", 0],
      "seed": "{{TRYON_SEED}}",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["6", 0]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["12", 0],
      "filename_prefix": "{{TRYON_FILENAME_PREFIX}}"
    }
  }
}
