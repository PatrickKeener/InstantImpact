{
  "_meta": {
    "name": "flux_still_character_split_v1",
    "description": "Flux BF16 still from split weights: UNETLoader + DualCLIPLoader + VAELoader. CLIP-L gets shot intent, T5 gets the full prompt. KSampler CFG remains 1.0.",
    "required_custom_nodes": [],
    "unet": "flux1-dev.safetensors (ComfyUI/models/diffusion_models/)",
    "clip": "clip_l.safetensors + t5xxl_fp16.safetensors (ComfyUI/models/clip/)",
    "vae": "ae.safetensors (ComfyUI/models/vae/)",
    "note": "Mirrors flux_still_character_v1 node-for-node; only the loaders differ, so node 12 (detail LoRA) and nodes 13-14 (hi-res) bypass identically."
  },
  "20": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{UNET_NAME}}",
      "weight_dtype": "{{UNET_WEIGHT_DTYPE}}"
    }
  },
  "21": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "{{CLIP_NAME1}}",
      "clip_name2": "{{CLIP_NAME2}}",
      "type": "flux"
    }
  },
  "22": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{VAE_NAME}}"
    }
  },
  "12": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "{{DETAIL_LORA_NAME}}",
      "strength_model": "{{DETAIL_LORA_STRENGTH}}",
      "strength_clip": 0.0,
      "model": ["20", 0],
      "clip": ["21", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": {
      "clip": ["12", 1],
      "clip_l": "{{CLIP_L_PROMPT}}",
      "t5xxl": "{{POSITIVE_PROMPT}}",
      "guidance": "{{GUIDANCE}}"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["12", 1]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER_NAME}}",
      "scheduler": "{{SCHEDULER}}",
      "denoise": 1.0,
      "model": ["12", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "13": {
    "class_type": "LatentUpscale",
    "inputs": {
      "upscale_method": "nearest-exact",
      "width": "{{HIRES_WIDTH}}",
      "height": "{{HIRES_HEIGHT}}",
      "crop": "disabled",
      "samples": ["3", 0]
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{HIRES_SAMPLER_NAME}}",
      "scheduler": "{{HIRES_SCHEDULER}}",
      "denoise": "{{HIRES_DENOISE}}",
      "model": ["12", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["13", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["22", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "images": ["8", 0]
    }
  }
}
