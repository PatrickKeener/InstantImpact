# InstantImpact — canonical .env (ONE copy of each key)
#
# If a key appears twice, the LAST line wins. That is why the live nemesis
# file grew duplicates (COMFY_URL, REDIS_URL, PORT, PUBLIC_BASE_URL).
# Keep the list below; delete extras.
#
# Do not set HF_TOKEN unless it is the same live token as INSTANTIMPACT_HF_TOKEN.
# A placeholder like HF_TOKEN=hf_PASTE_TOKEN_HERE is worse than omitting it.
#
# Local laptop defaults. Production on nemesis: copy .env.nemesis.example → .env
# (same keys, LAN/GPU values). See docs/quality-phases.md for the checkpoint swap.

# --- process ---
INSTANTIMPACT_NODE_ROLE=all-in-one
INSTANTIMPACT_NODE_NAME=local

# --- bind / UI ---
INSTANTIMPACT_HOST=127.0.0.1
INSTANTIMPACT_PORT=8000
INSTANTIMPACT_PUBLIC_BASE_URL=http://127.0.0.1:8000
INSTANTIMPACT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- data ---
INSTANTIMPACT_DATA_DIR=./data
INSTANTIMPACT_DATABASE_URL=sqlite+aiosqlite:///./data/db/instantimpact.sqlite
INSTANTIMPACT_REDIS_URL=redis://127.0.0.1:6379/0

# --- Comfy (filename only for the checkpoint; full dir for Comfy itself) ---
INSTANTIMPACT_COMFY_ENABLED=false
INSTANTIMPACT_COMFY_URL=http://127.0.0.1:8188
# INSTANTIMPACT_COMFY_DIR=/home/pkeener/ComfyUI
# How the model is loaded. "checkpoint" = one packed file via CheckpointLoaderSimple.
# "split" = UNETLoader + DualCLIPLoader + VAELoader, required for bf16 Flux.1-dev
# because that release ships the diffusion model with no text encoders or VAE.
INSTANTIMPACT_COMFY_LOADER=checkpoint

# --- checkpoint loader: packed file in ComfyUI/models/checkpoints/ ---
INSTANTIMPACT_COMFY_CKPT_NAME=flux1-dev-fp8.safetensors

# --- split loader: one file per component, ignored unless LOADER=split ---
# Photoreal (recommended): python scripts/bootstrap_models.py --profile krea --i-accept-licenses
# INSTANTIMPACT_COMFY_LOADER=split
# INSTANTIMPACT_COMFY_UNET_NAME=flux1-krea-dev.safetensors
# INSTANTIMPACT_TRAIN_BASE_MODEL=black-forest-labs/FLUX.1-Krea-dev
# diffusion model in ComfyUI/models/diffusion_models/ (NOT models/checkpoints/)
# INSTANTIMPACT_COMFY_UNET_NAME=flux1-dev.safetensors
# default | fp8_e4m3fn | fp8_e5m2 — "default" keeps bf16, the point of the upgrade
# INSTANTIMPACT_COMFY_UNET_DTYPE=default
# text encoders in ComfyUI/models/clip/
# INSTANTIMPACT_COMFY_CLIP_NAME1=clip_l.safetensors
# t5xxl_fp16 costs ~10GB VRAM; swap to t5xxl_fp8_e4m3fn.safetensors if tight
# INSTANTIMPACT_COMFY_CLIP_NAME2=t5xxl_fp16.safetensors
# VAE in ComfyUI/models/vae/
# INSTANTIMPACT_COMFY_VAE_NAME=ae.safetensors
# Must stay the same Flux family as the sampler (retrain LoRAs only after a finetune swap).
INSTANTIMPACT_TRAIN_BASE_MODEL=black-forest-labs/FLUX.1-dev
# INSTANTIMPACT_COMFY_LORAS_DIR=/home/pkeener/ComfyUI/models/loras
# Optional anatomy/realism LoRA filename in that loras dir. Studio can override per character.
# INSTANTIMPACT_DETAIL_LORA_NAME=
# Filename in ComfyUI/models/upscale_models. Empty = lanczos ImageScale only.
# INSTANTIMPACT_COMFY_UPSCALE_MODEL=
# Filename in ComfyUI/models/pulid. Empty = PuLID subgraph dropped.
# INSTANTIMPACT_PULID_MODEL=
# INSTANTIMPACT_PULID_PROVIDER=CUDA
# INSTANTIMPACT_LORA_DIM=32
INSTANTIMPACT_WORKFLOWS_DIR=./workflows
INSTANTIMPACT_COMFY_TIMEOUT=600
# job = worker starts/stops Comfy per still job so vLLM/Ollama get the GPU back.
# INSTANTIMPACT_COMFY_LIFECYCLE=job
# INSTANTIMPACT_COMFY_IDLE_GRACE=45
# Optional host-Docker GPU handoff. Requires the worker's Docker socket mount.
# Exact container names only. Treated as the idle-state set: paused for a job,
# then all started afterwards regardless of their state beforehand.
# INSTANTIMPACT_GPU_PAUSE_CONTAINERS=ollama,nemotron-ocr-nim,vllm
# Seconds to let a container finish its healthcheck before pausing it. Slow
# starters (NVIDIA NIMs) corrupt their workspace if stopped mid-initialization.
# INSTANTIMPACT_GPU_PAUSE_HEALTH_TIMEOUT=120
# INSTANTIMPACT_JOB_TIMEOUT=14400

# --- generation ---
INSTANTIMPACT_MOCK_GENERATION=true

# --- safety / LAN ---
INSTANTIMPACT_STRICT_OFFLINE=false
INSTANTIMPACT_REQUIRE_AUTH_TOKEN=false
INSTANTIMPACT_API_TOKEN=

# --- flags ---
INSTANTIMPACT_ENABLE_SDXL=false
INSTANTIMPACT_ENABLE_VIDEO=false
INSTANTIMPACT_ENABLE_CAPTIONS=false
INSTANTIMPACT_ENABLE_EXTERNAL_REFS=false
INSTANTIMPACT_ENABLE_PRODUCT_UPLOADS=true

# --- LoRA train ---
# INSTANTIMPACT_AI_TOOLKIT_DIR=/home/pkeener/ai-toolkit
# INSTANTIMPACT_HF_TOKEN=
INSTANTIMPACT_LORA_TRAIN_STEPS=1500
