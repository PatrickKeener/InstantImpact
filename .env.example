# InstantImpact — canonical .env (ONE copy of each key)
#
# If a key appears twice, the LAST line wins. That is why the live nemesis
# file grew duplicates (COMFY_URL, REDIS_URL, PORT, PUBLIC_BASE_URL).
# Keep the list below; delete extras.
#
# Do not set HF_TOKEN unless it is the same live token as INSTANTIMPACT_HF_TOKEN.
# A placeholder like HF_TOKEN=hf_PASTE_TOKEN_HERE is worse than omitting it.
#
# Local laptop defaults. Production on nemesis: copy .env.nemesis.example → .env
# (same keys, LAN/GPU values). See docs/quality-phases.md for the checkpoint swap.

# --- process ---
INSTANTIMPACT_NODE_ROLE=all-in-one
INSTANTIMPACT_NODE_NAME=local

# --- bind / UI ---
INSTANTIMPACT_HOST=127.0.0.1
INSTANTIMPACT_PORT=8000
INSTANTIMPACT_PUBLIC_BASE_URL=http://127.0.0.1:8000
INSTANTIMPACT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- data ---
INSTANTIMPACT_DATA_DIR=./data
INSTANTIMPACT_DATABASE_URL=sqlite+aiosqlite:///./data/db/instantimpact.sqlite
INSTANTIMPACT_REDIS_URL=redis://127.0.0.1:6379/0

# --- Comfy (filename only for the checkpoint; full dir for Comfy itself) ---
INSTANTIMPACT_COMFY_ENABLED=false
INSTANTIMPACT_COMFY_URL=http://127.0.0.1:8188
# INSTANTIMPACT_COMFY_DIR=/home/pkeener/ComfyUI
# Packed file in ComfyUI/models/checkpoints/. Keep ONE. bf16 is preferred on L40S.
INSTANTIMPACT_COMFY_CKPT_NAME=flux1-dev.safetensors
# INSTANTIMPACT_COMFY_CKPT_NAME=flux1-dev-fp8.safetensors
# Must stay the same Flux family as the sampler (retrain LoRAs only after a finetune swap).
INSTANTIMPACT_TRAIN_BASE_MODEL=black-forest-labs/FLUX.1-dev
# INSTANTIMPACT_COMFY_LORAS_DIR=/home/pkeener/ComfyUI/models/loras
# Optional anatomy/realism LoRA filename in that loras dir. Studio can override per character.
# INSTANTIMPACT_DETAIL_LORA_NAME=
INSTANTIMPACT_WORKFLOWS_DIR=./workflows
INSTANTIMPACT_COMFY_TIMEOUT=600
# INSTANTIMPACT_JOB_TIMEOUT=14400

# --- generation ---
INSTANTIMPACT_MOCK_GENERATION=true

# --- safety / LAN ---
INSTANTIMPACT_STRICT_OFFLINE=false
INSTANTIMPACT_REQUIRE_AUTH_TOKEN=false
INSTANTIMPACT_API_TOKEN=

# --- flags ---
INSTANTIMPACT_ENABLE_SDXL=false
INSTANTIMPACT_ENABLE_VIDEO=false
INSTANTIMPACT_ENABLE_CAPTIONS=false
INSTANTIMPACT_ENABLE_EXTERNAL_REFS=false
INSTANTIMPACT_ENABLE_PRODUCT_UPLOADS=true

# --- LoRA train ---
# INSTANTIMPACT_AI_TOOLKIT_DIR=/home/pkeener/ai-toolkit
# INSTANTIMPACT_HF_TOKEN=
INSTANTIMPACT_LORA_TRAIN_STEPS=1500
