# InstantImpact — run everything on nemesis (L40S) 10.10.101.150
# Copy to .env on nemesis:  copy .env.nemesis.example .env

INSTANTIMPACT_NODE_ROLE=all-in-one
INSTANTIMPACT_NODE_NAME=nemesis

# LAN bind so chamber / other PCs can open the UI
INSTANTIMPACT_HOST=0.0.0.0
INSTANTIMPACT_PORT=8000
INSTANTIMPACT_PUBLIC_BASE_URL=http://10.10.101.150:8000
INSTANTIMPACT_CORS_ORIGINS=http://10.10.101.150:5173,http://10.10.101.150:8000,http://nemesis:5173,http://127.0.0.1:5173,http://localhost:5173

# Local data on nemesis (fast disk preferred for models+outputs)
INSTANTIMPACT_DATA_DIR=./data
INSTANTIMPACT_DATABASE_URL=sqlite+aiosqlite:///./data/db/instantimpact.sqlite

# Local Redis (do not expose to LAN if possible)
INSTANTIMPACT_REDIS_URL=redis://127.0.0.1:6379/0

# ComfyUI on same machine — keep loopback only
INSTANTIMPACT_COMFY_URL=http://127.0.0.1:8188
INSTANTIMPACT_COMFY_ENABLED=false

# true until Comfy + Flux workflow are pinned; then false
INSTANTIMPACT_MOCK_GENERATION=true

# Required when binding 0.0.0.0 on a trusted LAN
INSTANTIMPACT_REQUIRE_AUTH_TOKEN=true
INSTANTIMPACT_API_TOKEN=change-me-to-a-long-random-secret

INSTANTIMPACT_STRICT_OFFLINE=false
INSTANTIMPACT_ENABLE_SDXL=false
INSTANTIMPACT_ENABLE_VIDEO=false
INSTANTIMPACT_ENABLE_CAPTIONS=false
INSTANTIMPACT_ENABLE_EXTERNAL_REFS=false
