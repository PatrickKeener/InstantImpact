# InstantImpact — run everything on nemesis (L40S) 10.10.101.150
# Copy to .env on nemesis:  cp .env.nemesis.example .env

INSTANTIMPACT_NODE_ROLE=all-in-one
INSTANTIMPACT_NODE_NAME=nemesis

# LAN bind so chamber / other PCs can open the UI (API on 8001 if vLLM owns 8000)
INSTANTIMPACT_HOST=0.0.0.0
INSTANTIMPACT_PORT=8001
INSTANTIMPACT_PUBLIC_BASE_URL=http://10.10.101.150:8001
INSTANTIMPACT_CORS_ORIGINS=http://10.10.101.150:5173,http://10.10.101.150:8001,http://nemesis:5173,http://127.0.0.1:5173,http://localhost:5173

# Local data on nemesis (fast disk preferred for models+outputs)
INSTANTIMPACT_DATA_DIR=./data
INSTANTIMPACT_DATABASE_URL=sqlite+aiosqlite:///./data/db/instantimpact.sqlite

# Local Redis (do not expose to LAN if possible)
INSTANTIMPACT_REDIS_URL=redis://127.0.0.1:6379/0

# ComfyUI on same machine — keep loopback only
# Required if you start scripts as root (HOME=/root is not where Comfy lives).
INSTANTIMPACT_COMFY_DIR=/home/pkeener/ComfyUI
INSTANTIMPACT_COMFY_URL=http://127.0.0.1:8188
INSTANTIMPACT_COMFY_ENABLED=true
# Still base. Stock Flux.1-dev has a weak bare-anatomy prior (filtered training
# set); swap to an unfiltered Flux finetune to fix that at the source. Keep this
# matched to INSTANTIMPACT_TRAIN_BASE_MODEL below. See docs/model_cards.md.
INSTANTIMPACT_COMFY_CKPT_NAME=flux1-dev-fp8.safetensors
# Optional anatomy/realism LoRA (filename only). Studio per-character value wins if set.
# INSTANTIMPACT_DETAIL_LORA_NAME=
# Per-prompt Comfy timeout (one still). Must stay well below
# INSTANTIMPACT_JOB_TIMEOUT, which covers the whole batch.
INSTANTIMPACT_COMFY_TIMEOUT=600
# Outer per-job backstop, seconds. Covers an entire batch (seed galleries allow
# up to 40 stills) or a full LoRA training run. arq defaults to 300s, which
# truncates real batches mid-run. Default here is 14400 (4h).
# INSTANTIMPACT_JOB_TIMEOUT=14400
INSTANTIMPACT_COMFY_LORAS_DIR=/home/pkeener/ComfyUI/models/loras
INSTANTIMPACT_WORKFLOWS_DIR=./workflows

# Ostris AI Toolkit (Studio "Train LoRA & register"). Native GPU worker required.
INSTANTIMPACT_AI_TOOLKIT_DIR=/home/pkeener/ai-toolkit
# Hugging Face token with FLUX.1-dev license accepted (also accepted as HF_TOKEN)
# INSTANTIMPACT_HF_TOKEN=
INSTANTIMPACT_LORA_TRAIN_STEPS=1500
# Base weights the character LoRA trains against — an HF repo id or a local
# path. Point this at the same model the sampler loads, or identity fidelity
# drops because the LoRA is a delta against weights the sampler no longer has.
# INSTANTIMPACT_TRAIN_BASE_MODEL=black-forest-labs/FLUX.1-dev

# false = real Flux via worker + Comfy; true = placeholder stills
INSTANTIMPACT_MOCK_GENERATION=false

# Required when binding 0.0.0.0 on a trusted LAN
INSTANTIMPACT_REQUIRE_AUTH_TOKEN=true
INSTANTIMPACT_API_TOKEN=change-me-to-a-long-random-secret

INSTANTIMPACT_STRICT_OFFLINE=false
INSTANTIMPACT_ENABLE_SDXL=false
INSTANTIMPACT_ENABLE_VIDEO=false
INSTANTIMPACT_ENABLE_CAPTIONS=false
INSTANTIMPACT_ENABLE_EXTERNAL_REFS=false
