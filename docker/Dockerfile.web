FROM node:20-bookworm-slim AS build

WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm install
COPY apps/web/ ./

# Dev proxy target is compile-time for Vite only when using import.meta;
# runtime preview still needs API on host — we use vite preview + proxy via env at start.
ARG VITE_API_PROXY=http://127.0.0.1:8001
ENV VITE_API_PROXY=$VITE_API_PROXY
RUN npm run build

FROM node:20-bookworm-slim
WORKDIR /web
COPY --from=build /web /web
ENV HOST=0.0.0.0
ENV PORT=5173
# Runtime proxy target (vite.config.ts reads this). Nemesis API is 8001.
ENV VITE_API_PROXY=http://127.0.0.1:8001
EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
